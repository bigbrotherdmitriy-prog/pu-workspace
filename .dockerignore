# Deny by default: only the inputs used by the source-built application are sent.
**
!backend/
!backend/Dockerfile
!backend/requirements.txt
!backend/alembic.ini
!backend/app/
!backend/app/**
!backend/scripts/
!backend/scripts/**
!backend/migrations/
!backend/migrations/**
!backend/tests/
!backend/tests/**
!frontend/
!frontend/**
!Dockerfile.ci
!.dockerignore
!Dockerfile.ci.dockerignore

# These exclusions come last, after the source allowlist, for both recipes.
**/.git
**/.codex
**/.agents
**/.aws
**/.ssh
**/.server-access
**/.env*
**/node_modules
**/react_dist
**/__pycache__
**/.pytest_cache
**/.cache
**/.npm_cache*
**/*.pyc
**/*.pyo
**/*.tsbuildinfo
**/*.log
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.jks
**/*.keystore
frontend/dist
