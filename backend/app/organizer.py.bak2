from datetime import datetime, timezone
from typing import Optional

from fastapi import APIRouter, HTTPException
from pydantic import BaseModel, Field

router = APIRouter(prefix="/organizer", tags=["organizer"])


# MVP in-memory proposal store.
# Later this will be moved to PostgreSQL and connected to Google Drive copy/apply.
PROPOSALS: dict[int, dict] = {}
NEXT_ID = 1


class AnalyzeRequest(BaseModel):
    project_id: int
    folder_name: str = Field(min_length=1, max_length=500)
    files: list[str] = Field(default_factory=list)


class DecisionRequest(BaseModel):
    approved: bool
    note: Optional[str] = None


def classify_file(name: str) -> str:
    lower = name.lower()

    if lower.endswith((".pdf", ".doc", ".docx", ".txt", ".rtf")):
        return "documents"

    if lower.endswith((".xls", ".xlsx", ".csv")):
        return "tables"

    if lower.endswith((".ppt", ".pptx")):
        return "presentations"

    if lower.endswith((".jpg", ".jpeg", ".png", ".gif", ".webp", ".svg")):
        return "images"

    if lower.endswith((".zip", ".rar", ".7z", ".tar", ".gz")):
        return "archives"

    return "other"


def proposed_name(name: str) -> str:
    cleaned = " ".join(name.strip().split())
    return cleaned


@router.get("/status")
def organizer_status():
    return {
        "status": "ok",
        "module": "organizer",
        "mode": "preview-first",
        "originals_modified": False,
    }


@router.post("/analyze")
def analyze_folder(payload: AnalyzeRequest):
    global NEXT_ID

    proposal_id = NEXT_ID
    NEXT_ID += 1

    actions = []

    for index, filename in enumerate(payload.files, start=1):
        category = classify_file(filename)
        new_name = proposed_name(filename)

        actions.append(
            {
                "order": index,
                "action": "organize",
                "source": filename,
                "target_folder": category,
                "proposed_name": new_name,
                "requires_confirmation": True,
            }
        )

    proposal = {
        "id": proposal_id,
        "project_id": payload.project_id,
        "folder_name": payload.folder_name,
        "status": "waiting_confirmation",
        "created_at": datetime.now(timezone.utc).isoformat(),
        "originals_modified": False,
        "actions": actions,
    }

    PROPOSALS[proposal_id] = proposal

    return proposal


@router.get("/proposals")
def list_proposals():
    return {
        "proposals": list(PROPOSALS.values()),
        "count": len(PROPOSALS),
    }


@router.get("/proposals/{proposal_id}")
def get_proposal(proposal_id: int):
    proposal = PROPOSALS.get(proposal_id)

    if proposal is None:
        raise HTTPException(status_code=404, detail="Proposal not found")

    return proposal


@router.post("/proposals/{proposal_id}/decision")
def proposal_decision(proposal_id: int, payload: DecisionRequest):
    proposal = PROPOSALS.get(proposal_id)

    if proposal is None:
        raise HTTPException(status_code=404, detail="Proposal not found")

    if proposal["status"] != "waiting_confirmation":
        raise HTTPException(
            status_code=409,
            detail="Proposal already processed",
        )

    proposal["status"] = "approved" if payload.approved else "rejected"
    proposal["decision_note"] = payload.note
    proposal["decided_at"] = datetime.now(timezone.utc).isoformat()

    return proposal


@router.post("/proposals/{proposal_id}/apply")
def apply_proposal(proposal_id: int):
    proposal = PROPOSALS.get(proposal_id)

    if proposal is None:
        raise HTTPException(status_code=404, detail="Proposal not found")

    if proposal["status"] != "approved":
        raise HTTPException(
            status_code=409,
            detail="Proposal must be approved before apply",
        )

    # Important MVP safety rule:
    # no Google Drive mutation is performed here yet.
    # We mark the plan as ready for the copy-only execution layer.
    proposal["status"] = "ready_to_apply_to_copy"
    proposal["originals_modified"] = False
    proposal["prepared_at"] = datetime.now(timezone.utc).isoformat()

    return proposal
