  "interface_requests": {
    "IR-01": {
      "owner": "A/B/integrator",
      "topic": "Extraction and evidence locator",
      "decision": "A/B/C currently accept prepared pins/DTO, not raw-text extraction. A whole_object/no-fragment facade does not prove excerpt/operator source UX. Provide authorised locator/fragment mapping; preserve raw quote only where policy permits."
    },
    "IR-02": {
      "owner": "integrator",
      "topic": "Legacy Message identity",
      "decision": "Plan mailbox-scoped uniqueness and migration for unknown legacy mailbox; required project cannot represent unassigned origin. No salted IDs, fake shared project or identity guessing."
    },
    "IR-03": {
      "owner": "Task/Trust + product owner",
      "topic": "Date versus instant",
      "decision": "Agree timestamp/timezone precision or explicitly exclude timed deadlines; do not silently truncate 18:30 to a date."
    },
    "IR-04": {
      "owner": "authority/integrator",
      "topic": "Durable authority and revoke races",
      "decision": "Supply authoritative tenant/mailbox/project/source ACL, evidence revoke epochs and lock ordering at mutation guard. Synthetic policy maps are not a durable authority proof."
    },
    "IR-05": {
      "owner": "Task/Trust/jobs integrator",
      "topic": "Real transaction/fault harness",
      "decision": "Supply approved real Task helper, pending intent reconciler, queue key mapping and process/PG fault barriers. Use existing queue; no new ledger or queue."
    },
    "IR-06": {
      "owner": "Source/Evidence + policy owner",
      "topic": "No copy/no fragment",
      "decision": "Define permissible metadata versus materialization. Harness must withhold oracle content and inspect approved storage/log sinks. No new retention rights inferred."
    },
    "IR-07": {
      "owner": "product owner + future external integration",
      "topic": "UNKNOWN external outcome",
      "decision": "Only fake-state oracle now; future provider reconciliation and UNKNOWN recovery contract required before external execution."
    },
    "IR-08": {
      "owner": "product owner + finance integration",
      "topic": "User-confirmed payment",
      "decision": "Payment event and DDS linkage need separate contract; no mandatory bank statement, no payment inference from invoice. No finance execution in pilot."
    },
    "IR-09": {
      "owner": "product owner",
      "topic": "AUTO/external actions",
      "decision": "Keep disabled in pilot; any future allow-list and approval policy requires explicit scope decision."
    }
  },
