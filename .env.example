POSTGRES_PASSWORD=replace-with-a-long-random-password
APP_SECRET_KEY=replace-with-at-least-32-random-characters
TOKEN_ENCRYPTION_KEY=generate-with-python-cryptography-fernet
BOOTSTRAP_TOKEN=replace-with-at-least-24-random-characters
AUTH_SESSION_HOURS=24
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/projects/google/callback
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URI=http://localhost:3000/projects/yandex/callback
PU_DRIVE_SERVICE_FACTORY=app.api.google_drive:drive_service_for_project
MAX_FILES_PER_SCAN=2000
ORGANIZER_MIN_AUTO_CONFIDENCE=0.65
ORGANIZER_AUTO_APPLY=false
ORGANIZER_AUTO_APPLY_CONFIDENCE=0.90
ORGANIZER_WORKERS=2
TELEGRAM_BOT_TOKEN=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
PU_ANDROID_CERT_SHA256=
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta
TELEGRAM_CHAT_ID=
# Local provider-agnostic OCR. Document bytes stay on the application host.
OCR_ENABLED=true
OCR_LANGUAGES=rus+eng
OCR_MAX_PAGES=20
OCR_TIMEOUT_SECONDS=120
OCR_DPI=300
OCR_PSM=1
OCR_FALLBACK_PSM=6
OCR_ADAPTIVE_FALLBACK=true
OCR_FALLBACK_MAX_PAGES=2
